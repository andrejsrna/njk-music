generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELED
}

enum InvoiceState {
  PENDING
  ISSUED
  FAILED
}

/// One product per release (slug = content/music slug). Active only once a master file is on R2.
model Product {
  id         String      @id @default(cuid())
  slug       String      @unique
  title      String
  priceCents Int         @default(150)
  currency   String      @default("eur")
  active     Boolean     @default(false)
  fileKey    String?
  fileName   String?
  fileSize   Int?
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Order {
  id                    String       @id @default(cuid())
  status                OrderStatus  @default(PENDING)
  email                 String?
  customerName          String?
  billingAddress        Json?
  taxIds                Json?
  currency              String       @default("eur")
  amountTotal           Int
  stripeSessionId       String?      @unique
  stripePaymentIntentId String?      @unique
  withdrawalConsentAt   DateTime
  paidAt                DateTime?
  refundedAt            DateTime?
  emailSentAt           DateTime?
  invoiceState          InvoiceState @default(PENDING)
  invoiceNumber         String?      @unique
  invoiceUrl            String?
  invoiceAttempts       Int          @default(0)
  invoiceError          String?
  items                 OrderItem[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  title         String
  priceCents    Int
  downloadCount Int     @default(0)

  @@index([orderId])
  @@index([productId])
}
